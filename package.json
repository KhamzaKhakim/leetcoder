{
  "name": "leetcoder",
  "publisher": "khamzakhakim",
  "displayName": "leetcoder",
  "description": "Leetcode VS-code extension",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "leetcoder.openProblem",
        "title": "LeetCoder: Open Problem"
      },
      {
        "command": "leetcoder.login",
        "title": "LeetCoder: Login"
      },
      {
        "command": "leetcoder.logout",
        "title": "LeetCoder: Logout"
      },
      {
        "command": "leetcoder.upload",
        "title": "LeetCoder: Upload (For Testing)"
      },
      {
        "command": "leetcoder.setLanguage",
        "title": "LeetCoder: Set Language"
      },
      {
        "command": "leetcoder.setPath",
        "title": "LeetCoder: Set Solutions Path"
      },
      {
        "command": "leetcoder.openDescription",
        "title": "LeetCoder: Open task description"
      }
    ],
    "configuration": {
      "title": "LeetCoder",
      "type": "object",
      "properties": {
        "leetcoder.language": {
          "type": "string",
          "default": "typescript",
          "enum": [
            "typescript",
            "javascript"
          ],
          "enumDescriptions": [
            "TypeScript",
            "JavaScript"
          ],
          "description": "Programming language to use for solving LeetCode problems (only TypeScript and JavaScript are supported for now)"
        },
        "leetcoder.path": {
          "type": "string",
          "default": "",
          "description": "Path to the folder where LeetCode solution files will be saved",
          "scope": "resource"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "npm run compile-tests && mocha",
    "test:integration": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "mocha": "^12.0.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
